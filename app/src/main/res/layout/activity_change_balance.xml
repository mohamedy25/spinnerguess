<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Change Balance" android:textSize="24sp" android:textStyle="bold"
        android:layout_marginBottom="20dp" />
    <EditText android:id="@+id/etBalanceAmount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Amount"
        android:inputType="numberDecimal" />
    <RadioGroup android:id="@+id/balanceOperation" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton android:id="@+id/radioAdd" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Add" android:checked="true" />
        <RadioButton android:id="@+id/radioRemove" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Remove" />
    </RadioGroup>
    <Button android:id="@+id/btnConfirmBalance" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Continue" />
    <Button android:id="@+id/btnCancelBalance" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Back" />
</LinearLayout>